APP_NAME="Condominio San Diego"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=condominio_sa
DB_USERNAME=root
DB_PASSWORD=

# Para usar SQLite (desarrollo rápido):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@condominiosandiego.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (pagos con tarjeta)
STRIPE_KEY=pk_test_tu_clave_publica_aqui
STRIPE_SECRET=sk_test_tu_clave_secreta_aqui
STRIPE_WEBHOOK_SECRET=

# QR Code
QR_SIZE=200
